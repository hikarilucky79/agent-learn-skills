{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hikarilucky79/agent-video-lessons/schema/lesson.schema.json",
  "title": "Lesson Script",
  "description": "Structured video lesson script consumed by tts/synthesize.py and Remotion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "scenes"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "discipline", "language"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "minLength": 2,
          "description": "Lesson identifier in kebab-case."
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "discipline": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "language": {
          "type": "string",
          "enum": ["pt-BR", "en-US"]
        },
        "voice": {
          "type": "string",
          "minLength": 3
        },
        "aspectRatio": {
          "type": "string",
          "enum": ["16:9", "9:16"],
          "default": "16:9"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "heading", "narration"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["intro", "concept", "code_trace", "active_pause", "quiz_recap"]
          },
          "heading": {
            "type": "string",
            "minLength": 2,
            "maxLength": 140
          },
          "narration": {
            "type": "string",
            "minLength": 5
          },
          "subtitle": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "formula": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "codeLanguage": {
            "type": "string"
          },
          "highlightLines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "pauseSeconds": {
            "type": "number",
            "minimum": 3,
            "maximum": 8
          },
          "answer": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "correctIndex": {
            "type": "integer",
            "minimum": 0
          },
          "explanation": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "active_pause" } },
              "required": ["type"]
            },
            "then": {
              "required": ["pauseSeconds"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "quiz_recap" } },
              "required": ["type"]
            },
            "then": {
              "required": ["question", "options", "correctIndex", "explanation"]
            }
          },
          {
            "if": {
              "properties": { "type": { "const": "code_trace" } },
              "required": ["type"]
            },
            "then": {
              "required": ["code"]
            }
          }
        ]
      }
    }
  }
}
